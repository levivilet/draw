{
  "id": "builtindraw",
  "name": "Draw",
  "workerName": "Draw Worker",
  "description": "A whiteboard for creating lines, shapes, and text.",
  "repository": "https://github.com/levivilet/draw",
  "browser": "dist/drawMain.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "categories": ["Other"],
  "activation": [
    "onView:draw.views.whiteboard",
    "onCommand:draw.clear",
    "onCommand:draw.duplicate",
    "onCommand:draw.show"
  ],
  "commands": [
    {
      "id": "draw.show",
      "label": "Draw: Show Whiteboard"
    },
    {
      "id": "draw.clear",
      "label": "Draw: Clear Whiteboard"
    },
    {
      "id": "draw.duplicate",
      "label": "Draw: Duplicate Selected Shape"
    }
  ],
  "keybindings": [
    {
      "key": "Ctrl+D",
      "command": "draw.duplicate",
      "when": "draw.selectedShape"
    }
  ],
  "rpc": [
    {
      "id": "builtindraw.export-worker",
      "type": "web-worker",
      "name": "Draw Export Worker",
      "url": "dist/drawExportWorkerMain.js",
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"]
    }
  ],
  "views": [
    {
      "css": "media/draw.css",
      "displayName": "Draw",
      "id": "draw.views.whiteboard",
      "title": "Draw",
      "icon": "media/draw.svg",
      "kind": "virtualDom",
      "preferredLocation": "secondaryPreview"
    }
  ]
}
